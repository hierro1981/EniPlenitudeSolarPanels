# Copia questo file in .env. Non condividere mai questo file.
# COOKIE deve contenere il valore completo dell'header Cookie copiato dal browser,
# inclusi GYSESSION, GAESA e gli altri cookie eniplenitude.com.
COOKIE=

ACCOUNT_ID=
SUPPLY_ID=
POD=

# Valori supportati dipendono dal servizio; il valore noto e predefinito e' HOURLY.
GRANULARITY=HOURLY

# Lascia vuoto se non disponibile: logHash= resta comunque nella query string.
LOG_HASH=
